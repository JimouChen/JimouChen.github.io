---
import type { Post } from '../../lib/posts';
import { getPostUrl, getReadingMinutes } from '../../lib/posts';
import { formatDate, slugify } from '../../lib/utils';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const url = getPostUrl(post);
---

<article class:list={['card card-hover group overflow-hidden', featured && 'md:col-span-2 md:grid md:grid-cols-[1.05fr_0.95fr]']}>
  {post.data.cover && (
    <a href={url} class:list={['block overflow-hidden bg-surface-soft', featured ? 'h-full min-h-64' : 'aspect-[16/9]']} tabindex="-1" aria-hidden="true">
      <img src={post.data.cover} alt="" width="960" height="540" loading="lazy" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.025]" />
    </a>
  )}
  <div class:list={['flex flex-col p-6 sm:p-7', featured && 'justify-center md:p-9']}>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
      <a href={`/blog/category/${slugify(post.data.category)}/`} class="font-semibold text-accent hover:underline">{post.data.category}</a>
      <span class="size-0.5 rounded-full bg-muted"></span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span class="size-0.5 rounded-full bg-muted"></span>
      <span>{getReadingMinutes(post)} 分钟阅读</span>
    </div>
    <h2 class:list={['mt-4 font-semibold leading-snug tracking-[-0.035em]', featured ? 'text-2xl sm:text-3xl' : 'text-xl']}>
      <a href={url} class="transition-colors group-hover:text-accent">{post.data.title}</a>
    </h2>
    <p class="mt-3 line-clamp-3 text-sm leading-7 text-muted">{post.data.description}</p>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-2">
        {post.data.tags.slice(0, 2).map((tag) => <a class="tag transition-colors hover:text-accent" href={`/blog/tag/${slugify(tag)}/`}>#{tag}</a>)}
      </div>
      <a href={url} class="inline-flex items-center gap-1.5 text-xs font-semibold text-ink" aria-label={`阅读：${post.data.title}`}>
        阅读全文 <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</article>
