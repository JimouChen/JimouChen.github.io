---
interface Props {
  inputId: string;
  compact?: boolean;
}
const { inputId, compact = false } = Astro.props;
---

<div data-search-app class="w-full">
  <div class="relative">
    <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <label for={inputId} class="sr-only">搜索文章</label>
    <input id={inputId} data-search-input type="search" autocomplete="off" placeholder="搜索标题、正文、标签或分类…" class="w-full rounded-2xl border border-line bg-surface py-4 pl-12 pr-4 text-sm text-ink placeholder:text-muted focus:border-accent" />
  </div>
  <p data-search-status class="mt-4 min-h-5 text-xs text-muted" role="status">输入至少两个字符开始搜索</p>
  <div data-search-results class:list={['mt-2', compact ? 'max-h-[52vh] overflow-y-auto' : 'grid gap-4']}></div>
</div>

<script>
  import { searchPosts, type SearchResult } from '../../lib/search';

  document.querySelectorAll<HTMLElement>('[data-search-app]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const status = root.querySelector<HTMLElement>('[data-search-status]');
    const container = root.querySelector<HTMLElement>('[data-search-results]');
    if (!input || !status || !container) return;

    let timer: ReturnType<typeof setTimeout>;
    let requestId = 0;

    const renderResults = (results: SearchResult[]) => {
      container.replaceChildren();
      results.forEach((result) => {
        const link = document.createElement('a');
        link.href = result.url;
        link.className = 'group mb-3 block rounded-2xl border border-line bg-surface p-5 transition-colors hover:border-accent';
        const title = document.createElement('h2');
        title.className = 'text-sm font-semibold leading-6 text-ink group-hover:text-accent';
        title.textContent = result.title;
        const excerpt = document.createElement('p');
        excerpt.className = 'mt-2 line-clamp-2 text-xs leading-6 text-muted [&_mark]:bg-accent-soft [&_mark]:text-accent';
        excerpt.innerHTML = result.excerpt;
        link.append(title, excerpt);
        container.append(link);
      });
    };

    const runSearch = async () => {
      const query = input.value.trim();
      if (query.length < 2) {
        status.textContent = '输入至少两个字符开始搜索';
        container.replaceChildren();
        return;
      }
      const currentRequest = ++requestId;
      status.textContent = '正在搜索…';
      try {
        const results = await searchPosts(query);
        if (currentRequest !== requestId) return;
        status.textContent = results.length > 0 ? `找到 ${results.length} 条相关结果` : `没有找到与“${query}”相关的内容`;
        renderResults(results);
      } catch {
        if (currentRequest !== requestId) return;
        status.textContent = '搜索索引尚未生成，请先运行 npm run build';
        container.replaceChildren();
      }
    };

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(runSearch, 160);
    });
  });
</script>
