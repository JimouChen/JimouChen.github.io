---
import { navigation, site } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-site grid gap-10 py-12 md:grid-cols-[1.3fr_0.7fr_0.7fr]">
    <div>
      <a href="/" class="text-lg font-bold tracking-[-0.04em]">{site.name}<span class="text-accent">.</span></a>
      <p class="mt-3 max-w-sm text-sm leading-7 text-muted">在代码与生活之间，记录构建的过程。<br />一个由好奇心与长期主义驱动的小站。</p>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink">探索</h2>
      <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 text-sm text-muted md:grid-cols-1">
        {navigation.slice(1).map((item) => <a class="transition-colors hover:text-accent" href={item.href}>{item.label}</a>)}
        <a class="transition-colors hover:text-accent" href="/friends/">友链</a>
      </div>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink">保持联系</h2>
      <div class="mt-4 flex flex-col items-start gap-3 text-sm text-muted">
        <a class="transition-colors hover:text-accent" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a class="transition-colors hover:text-accent" href={`mailto:${site.email}`}>Email</a>
        <a class="transition-colors hover:text-accent" href="/rss.xml">RSS</a>
      </div>
    </div>
  </div>
  <div class="container-site flex flex-col gap-2 border-t border-line py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} Neaya. Built with Astro & curiosity.</p>
    <p>内容采用 CC BY-NC-SA 4.0 许可</p>
  </div>
</footer>
