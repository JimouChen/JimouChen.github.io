---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  large?: boolean;
}

const { project, large = false } = Astro.props;
---

<article class:list={['card card-hover group flex overflow-hidden', large ? 'flex-col sm:col-span-2 sm:grid sm:grid-cols-[1.05fr_0.95fr]' : 'flex-col']}>
  <div class:list={['overflow-hidden bg-surface-soft', large ? 'min-h-56' : 'aspect-[16/9]']}>
    <img src={project.cover} alt={`${project.name} 项目概念插画`} width="960" height="540" loading="lazy" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.025]" />
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div class="flex items-center justify-between gap-4">
      <span class="inline-flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.13em] text-muted"><span class="size-1.5 rounded-full bg-[#79b69b]"></span>{project.status}</span>
      <a href={project.github} target="_blank" rel="noreferrer" class="grid size-8 place-items-center rounded-full border border-line text-muted transition-colors hover:text-ink" aria-label={`在 GitHub 查看 ${project.name}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.78 2.7 1.27 3.36.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.82 1.19 3.08 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
      </a>
    </div>
    <h2 class="mt-5 break-words font-mono text-xl font-bold tracking-[-0.04em]"><a href={project.github} target="_blank" rel="noreferrer" class="hover:text-accent">{project.name}</a></h2>
    <p class="mt-3 flex-1 text-sm leading-7 text-muted">{project.description}</p>
    <div class="mt-5 flex flex-wrap gap-2">{project.stack.map((tech) => <span class="tag">{tech}</span>)}</div>
    <div class="mt-5 flex gap-4 text-xs font-medium">
      <a href={project.github} target="_blank" rel="noreferrer" class="text-ink hover:text-accent">源代码 ↗</a>
      {project.demo && <a href={project.demo} target="_blank" rel="noreferrer" class="text-accent hover:underline">在线演示 ↗</a>}
    </div>
  </div>
</article>
