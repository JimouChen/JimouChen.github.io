---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getPublishedPosts, getTags, type Post } from '../../../lib/posts';
import { slugify } from '../../../lib/utils';

interface Props {
  tag: string;
  posts: Post[];
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return getTags(posts).map(({ name }) => ({
    params: { tag: slugify(name) },
    props: { tag: name, posts: posts.filter((post) => post.data.tags.includes(name)) },
  }));
};

const { tag, posts } = Astro.props;
---

<BaseLayout title={`${tag} 标签`} description={`Neaya 博客中标记为 ${tag} 的 ${posts.length} 篇文章。`}>
  <div class="container-site py-16 sm:py-20">
    <header class="page-enter mx-auto max-w-2xl text-center">
      <a href="/blog/" class="text-sm text-muted hover:text-accent">← 全部文章</a>
      <span class="eyebrow mt-8 justify-center">Tag</span>
      <h1 class="mt-4 text-5xl font-bold tracking-[-0.055em]">#{tag}</h1>
      <p class="mt-4 text-muted">共 {posts.length} 篇文章</p>
    </header>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
