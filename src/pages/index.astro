---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import PostCard from '../components/blog/PostCard.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { getPublishedPosts } from '../lib/posts';
import { projects } from '../data/projects';
import { site } from '../data/site';

const posts = await getPublishedPosts();
const interests = [
  { number: '01', title: '构建可靠的系统', description: '以 Python 与 Go 为工具，关注服务架构、性能与工程效率。' },
  { number: '02', title: '探索智能的边界', description: '实践 AI Agent 与工作流，让模型真正进入开发与生活场景。' },
  { number: '03', title: '打磨产品体验', description: '从前端到 SwiftUI，在功能之外，也在意每一处细节与感受。' },
];
---

<BaseLayout>
  <Hero />
  <section class="container-site py-16 sm:py-20" aria-labelledby="focus-title">
    <div class="max-w-2xl">
      <span class="eyebrow">What I care about</span>
      <h2 id="focus-title" class="section-title">持续构建，也持续记录。</h2>
      <p class="section-description">这里不仅有技术方案，也有方案背后的思考、取舍与真实实践。</p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {interests.map((item) => (
        <article class="card card-hover p-6 sm:p-7"><span class="font-mono text-xs text-accent">{item.number}</span><h3 class="mt-6 text-lg font-semibold tracking-[-0.025em]">{item.title}</h3><p class="mt-3 text-sm leading-7 text-muted">{item.description}</p></article>
      ))}
    </div>
  </section>

  <section class="container-site py-16 sm:py-20" aria-labelledby="latest-title" data-pagefind-ignore>
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div><span class="eyebrow">Latest stories</span><h2 id="latest-title" class="section-title">最近写下</h2></div>
      <a href="/blog/" class="button button-secondary">全部文章 <span>→</span></a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{posts.slice(0, 3).map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="container-site py-16 sm:py-20" aria-labelledby="projects-title">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div><span class="eyebrow">Selected work</span><h2 id="projects-title" class="section-title">一些认真构建的作品</h2><p class="section-description">工具与系统，都是理解问题的一种方式。</p></div>
      <a href="/projects/" class="button button-secondary">全部项目 <span>→</span></a>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">{projects.slice(0, 3).map((project, index) => <ProjectCard project={project} large={index === 0} />)}</div>
  </section>

  <section class="container-site py-16">
    <a href={site.github} target="_blank" rel="noreferrer" class="card card-hover relative flex flex-col items-center justify-between gap-6 overflow-hidden p-8 text-center sm:p-12 md:flex-row md:text-left">
      <div class="absolute -right-16 -top-24 size-64 rounded-full bg-accent-soft blur-3xl"></div>
      <div class="relative"><span class="eyebrow">Open source & more</span><h2 class="mt-3 text-2xl font-semibold tracking-[-0.04em]">在 GitHub 上继续探索</h2><p class="mt-2 text-sm text-muted">更多项目、代码与正在进行的实验。</p></div>
      <span class="button button-primary relative shrink-0">@JimouChen ↗</span>
    </a>
  </section>
</BaseLayout>
