---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import { timeline } from '../data/timeline';
---

<BaseLayout title="时间轴" description="Neaya 的技术方向、创作计划与持续成长的记录。">
  <div class="container-site py-16 sm:py-20">
    <PageHeader eyebrow="The journey" title="一步一步，持续生长。" description="不是一份完成清单，而是正在发生的探索。记录此刻关注的事，以及愿意长期投入的方向。" />
    <div class="relative mx-auto mt-16 max-w-3xl">
      <div class="absolute bottom-6 left-[7px] top-3 w-px bg-gradient-to-b from-accent via-line to-transparent sm:left-[9px]"></div>
      {timeline.map((item, index) => (
        <article class="page-enter relative pb-12 pl-10 last:pb-0 sm:pl-14" style={`animation-delay: ${index * 80}ms`}>
          <span class="absolute left-0 top-2 size-[15px] rounded-full border-[3px] border-canvas bg-accent shadow-[0_0_0_1px_var(--accent)] sm:size-[19px]"></span>
          <time class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent">{item.period}</time>
          <div class="card mt-4 p-6 sm:p-8">
            <h2 class="text-xl font-semibold tracking-[-0.03em]">{item.title}</h2>
            <p class="mt-3 text-sm leading-7 text-muted">{item.description}</p>
            <div class="mt-5 flex flex-wrap gap-2">{item.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
